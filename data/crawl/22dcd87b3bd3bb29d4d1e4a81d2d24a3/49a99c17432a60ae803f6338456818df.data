        <span class="token punctuation" data-v-2bf71f8f="" data-v-46d16ea9="">{</span>
            <span class="token property" data-v-2bf71f8f="" data-v-46d16ea9="">"key"</span><span class="token operator" data-v-2bf71f8f="" data-v-46d16ea9="">:</span> <span class="token string" data-v-2bf71f8f="" data-v-46d16ea9="">"h2h"</span><span class="token punctuation" data-v-2bf71f8f="" data-v-46d16ea9="">,</span>
            <span class="token property" data-v-2bf71f8f="" data-v-46d16ea9="">"outcomes"</span><span class="token operator" data-v-2bf71f8f="" data-v-46d16ea9="">:</span> <span class="token punctuation" data-v-2bf71f8f="" data-v-46d16ea9="">[</span>
                <span class="token punctuation" data-v-2bf71f8f="" data-v-46d16ea9="">{</span> <span class="token property" data-v-2bf71f8f="" data-v-46d16ea9="">"name"</span><span class="token operator" data-v-2bf71f8f="" data-v-46d16ea9="">:</span> <span class="token string" data-v-2bf71f8f="" data-v-46d16ea9="">"Dallas Cowboys"</span><span class="token punctuation" data-v-2bf71f8f="" data-v-46d16ea9="">,</span> <span class="token property" data-v-2bf71f8f="" data-v-46d16ea9="">"price"</span><span class="token operator" data-v-2bf71f8f="" data-v-46d16ea9="">:</span> <span class="token number" data-v-2bf71f8f="" data-v-46d16ea9="">240</span> <span class="token punctuation" data-v-2bf71f8f="" data-v-46d16ea9="">}</span><span class="token punctuation" data-v-2bf71f8f="" data-v-46d16ea9="">,</span>
                <span class="token punctuation" data-v-2bf71f8f="" data-v-46d16ea9="">{</span> <span class="token property" data-v-2bf71f8f="" data-v-46d16ea9="">"name"</span><span class="token operator" data-v-2bf71f8f="" data-v-46d16ea9="">:</span> <span class="token string" data-v-2bf71f8f="" data-v-46d16ea9="">"Tampa Bay Buccaneers"</span><span class="token punctuation" data-v-2bf71f8f="" data-v-46d16ea9="">,</span> <span class="token property" data-v-2bf71f8f="" data-v-46d16ea9="">"price"</span><span class="token operator" data-v-2bf71f8f="" data-v-46d16ea9="">:</span> <span class="token number" data-v-2bf71f8f="" data-v-46d16ea9="">-303</span> <span class="token punctuation" data-v-2bf71f8f="" data-v-46d16ea9="">}</span>
            <span class="token punctuation" data-v-2bf71f8f="" data-v-46d16ea9="">]</span>
    ...</code></pre></div></div></div></div></section> <section data-v-46d16ea9=""><h2 id="get-access" data-v-46d16ea9=""><a href="#get-access" class="header-anchor" data-v-46d16ea9="">#</a> Get Access <span data-v-46d16ea9=""></span></h2> <p style="text-align:center;" data-v-46d16ea9="">
