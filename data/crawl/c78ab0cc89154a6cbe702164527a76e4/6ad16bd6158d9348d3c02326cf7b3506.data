ports<wbr>/{sport}<wbr>/odds</span></a></span><div class="opblock-summary-description"></div></div></button><span tooltip="Copy to clipboard" placement="top"><span class="opblock-summary-link icon icon-clipboard-list-light "></span></span><span><span aria-label="Show Explore tooltip on documentation page" class="text-xl opblock-summary-link icon icon-explore-tryitout-icon " data-explore-button-enabled="false"></span></span><button aria-label="get ​/v4​/sports​/{sport}​/odds" class="opblock-control-arrow" aria-expanded="false" tabindex="-1"><span class="opblock-summary-link icon icon-chevron-down-light "></span></button></div><noscript></noscript></div></span><span><div class="opblock opblock-get" id="operations-current_events-get_v4_sports__sport__scores"><div class="opblock-summary opblock-summary-get"><button aria-expanded="false" class="opblock-summary-control"><span class="opblock-summary-method">GET</span><div class="opblock-summary-path-description-wrapper"><span class="opblock-summary-path" data-path="/v4/sports/{sport}/scores"><a class="nostyle" href="#/current%20events/get_v4_sports__sport__scores"><span>/v4<wbr>/sports<wbr>/{sport}<wbr>/scores</span></a></span><div class="opblock-summary-description"></div></div></button><span tooltip="Copy to clipboard" placement="top"><span class="opblock-summary-link icon icon-clipboard-list-light "></span></span><span><span aria-label="Show Explore tooltip on documentation page" class="text-xl opblock-summary-link icon icon-explore-tryitout-icon " data-explore-button-enabled="false"></span></span><button aria-label="get ​/v4​/sports​/{sport}​/scores" class="opblock-control-arrow" aria-expanded="false" tabindex="-1"><span class="opblock-summary-link icon icon-chevron-down-light "></span></button></div><noscript></noscript></div></span><span><div class="opblock opblock-get" id="operations-current_events-get_v4_sports__sport__events"><div class="opblock-summary opblock-summary-get"><button aria-expanded="false" class="opblock-summary-control"><span class="opblock-summary-method">GET</span><div class="opblock-summary-path-description-wrapper"><span class="opblock-summary-path" data-path="/v4/sports/{sport}/events"><a class="nostyle" href="#/current%20events/get_v4_sports__sport__events"><span>/v4<wbr>/sports<wbr>/{sport}<wbr>/events</span></a></span><div class="opblock-summary-description"></div></div></button><span tooltip="Copy to clipboard" placement="top"><span class="opblock-summary-link icon icon-clipboard-list-light "></span></span><span><span aria-label="Show Explore tooltip on documentation page" class="text-xl opblock-summary-link icon icon-explore-tryitout-icon " data-explore-button-enabled="false"></span></span><button aria-label="get ​/v4​/sports​/{sport}​/events" class="opblock-control-arrow" aria-expanded="false" tabindex="-1"><span class="opblock-summary-link icon icon-chevron-down-light "></span></button></div><noscript></noscript></div></span><span><div class="opblock opblock-get" id="operations-current_events-get_v4_sports__sport__events__eventId__odds"><div class="opblock-summary opblock-summary-get"><button aria-expanded="false" class="opblock-summary-control"><span class="opblock-summary-method">GET</span><div class="opblock-summary-path-description-wrapper"><span class="opblock-summary-path" data-path="/v4/sports/{sport}/events/{eventId}/odds"><a class="nostyle" href="#/current%20events/get_v4_sports__sport__events__eventId__odds"><span>/v4<wbr>/sports<wbr>/{sport}<wbr>/events<wbr>/{eventId}<wbr>/odds</span></a></span><div class="opblock-summary-description"></div></div></button><span tooltip="Copy to clipboard" placement="top"><span class="opblock-summary-link icon icon-clipboard-list-light "></span></span><span><span aria-label="Show Explore tooltip on documentation page" class="text-xl opblock-summary-link icon icon-explore-tryitout-icon " data-explore-button-enabled="false"></span></span><button aria-label="get ​/v4​/sports​/{sport}​/events​/{eventId}​/odds" class="opblock-control-arrow" aria-expanded="false" tabindex="-1"><span class="opblock-summary-link icon icon-chevron-down-light "></span></button></div><noscript></noscript></div></span></div> </div></div></span></span><span><span><div class="opblock-tag-section is-open"><h3 class="opblock-tag" id="operations-tag-historical_events" data-tag="historical events" data-is-open="true"><a class="nostyle" href="#/historical%20events"><span>historical events</span></a><small><div class="renderedMarkdown"><p>Historical events and bookmaker odds as they appeared at a specified point in time. Historical snapshots for featured markets are available from June 2020, at 10 minute intervals until Sep 2022, and at 5 minute intervals thereafter. Snapshots of historical odds for non-featured markets (player props, period markets, alternates, etc.) are available from May 2023 at 5 minute intervals.</p></div></small><div class="info__externaldocs"><small><a href="https://the-odds-api.com/historical-odds-data/" target="_blank" rel="noopener noreferrer" class="link">Find out more</a></small></div><button aria-expanded="true" class="expand-operation" title="Collapse operation"><span class="opblock-summary-link icon icon-chevron-up-light "></span></button></h3><div class="no-margin"> <div class="operation-tag-content"><span><div class="opblock opblock-get" id="operations-historical_events-get_v4_historical_sports__sport__odds"><div class="opblock-summary opblock-summary-get"><button aria-expanded="false" class="opblock-summary-control"><span class="opblock-summary-method">GET</span><div class="opblock-summary-path-description-wrapper"><span class="opblock-summary-path" data-path="/v4/historical/sports/{sport}/odds"><a class="nostyle" href="#/historical%20events/get_v4_historical_sports__sport__odds"><span>/v4<wbr>/historical<wbr>/sports<wbr>/{sport}<wbr>/odds</span></a></span><div class="opblock-summary-description"></div></div></button><span tooltip="Copy to clipboard" placement="top"><