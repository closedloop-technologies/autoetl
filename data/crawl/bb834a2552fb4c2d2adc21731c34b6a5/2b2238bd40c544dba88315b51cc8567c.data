    <span class="token property">"sport_key"</span><span class="token operator">:</span> <span class="token string">"americanfootball_nfl"</span><span class="token punctuation">,</span>
    <span class="token property">"sport_title"</span><span class="token operator">:</span> <span class="token string">"NFL"</span><span class="token punctuation">,</span>
    <span class="token property">"commence_time"</span><span class="token operator">:</span> <span class="token string">"2023-01-01T18:00:00Z"</span><span class="token punctuation">,</span>
    <span class="token property">"home_team"</span><span class="token operator">:</span> <span class="token string">"Atlanta Falcons"</span><span class="token punctuation">,</span>
    <span class="token property">"away_team"</span><span class="token operator">:</span> <span class="token string">"Arizona Cardinals"</span><span class="token punctuation">,</span>
